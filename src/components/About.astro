---
import { siteData } from '../data/site';

const { philosophy } = siteData;
---

<section 
  id="about" 
  class="relative py-24 sm:py-32 lg:py-40 px-6 sm:px-8 lg:px-12 border-t border-[#111111]/10"
  aria-label="Studio Philosophy & Methodology"
>
  <!-- Centered Vertical Hairline Divider -->
  <div class="flex justify-center mb-16 sm:mb-20">
    <div class="w-[1px] h-20 sm:h-28 bg-[#111111]/30"></div>
  </div>

  <div class="max-w-[1400px] mx-auto">
    <!-- Section Badge / Indicator -->
    <div class="flex items-center justify-between text-[#838282] font-body text-xs tracking-[0.25em] uppercase mb-12 sm:mb-16">
      <span>{philosophy.badge}</span>
      <span class="hidden sm:inline-block">EXCITEE / METHOD</span>
    </div>

    <!-- Editorial Statement with Contrasting Serif Italic Emphasized Keyword -->
    <div class="max-w-5xl">
      <h2 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.95] tracking-[-0.04em] text-[#111111] uppercase">
        {philosophy.statementPart1}
        <span class="font-editorial-italic font-normal normal-case tracking-normal px-1 text-[#111111] underline decoration-[#838282]/40 decoration-1 underline-offset-8">
          {philosophy.statementEmphasized}
        </span>
        {philosophy.statementPart2}
      </h2>
    </div>

    <!-- 3-Column Information Grid with 32px Gaps -->
    <div class="mt-20 sm:mt-28 grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10 lg:gap-12 pt-12 border-t border-[#111111]/15">
      {philosophy.pillars.map((pillar) => (
        <div class="flex flex-col justify-between group">
          <div>
            <div class="font-body text-xs tracking-[0.2em] uppercase text-[#838282] mb-4">
              // {pillar.number}
            </div>
            <h3 class="font-display text-xl sm:text-2xl uppercase tracking-[-0.02em] text-[#111111] mb-4">
              {pillar.title}
            </h3>
            <p class="font-body text-[#111111]/80 text-sm sm:text-base leading-relaxed">
              {pillar.description}
            </p>
          </div>
          <div class="mt-8 pt-4 border-b border-[#111111]/10 group-hover:border-[#111111] transition-colors duration-300"></div>
        </div>
      ))}
    </div>
  </div>
</section>
