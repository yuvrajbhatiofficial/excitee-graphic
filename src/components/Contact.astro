---
import { siteData } from '../data/site';

const { contact, brand } = siteData;
const lines = contact.headline.split('\n');
---

<section 
  id="contact" 
  class="relative py-24 sm:py-32 lg:py-40 px-6 sm:px-8 lg:px-12 border-t border-[#111111]/10 bg-[#f2f2f2]"
  aria-label="Contact Studio"
>
  <div class="max-w-[1400px] mx-auto">
    <!-- Header Indicator -->
    <div class="flex items-center justify-between text-[#838282] font-body text-xs tracking-[0.25em] uppercase mb-12 sm:mb-16">
      <span>04 // INQUIRIES</span>
      <span>{contact.location}</span>
    </div>

    <!-- Massive Typographic Headline -->
    <div class="max-w-5xl">
      <h2 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl uppercase tracking-[-0.05em] text-[#111111] leading-[0.88] mb-8">
        {lines.map((line) => (
          <span class="block">{line}</span>
        ))}
      </h2>
      <p class="font-body text-[#111111]/80 text-lg sm:text-2xl font-normal max-w-xl mb-12 sm:mb-16">
        {contact.supportingStatement}
      </p>
    </div>

    <!-- Interactive Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pt-12 border-t border-[#111111]/15 items-start">
      <!-- Direct Email Copy & Mailto Action (7 Cols) -->
      <div class="md:col-span-7 flex flex-col gap-6">
        <span class="font-body text-xs tracking-[0.2em] uppercase text-[#838282]">
          DIRECT INQUIRIES & NEW BUSINESS
        </span>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <a 
            href={`mailto:${contact.email}`}
            class="group inline-flex items-center gap-3 font-display text-2xl sm:text-3xl lg:text-4xl text-[#111111] hover:text-[#838282] transition-colors duration-200"
          >
            <span>{contact.email}</span>
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              width="24" 
              height="24" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2" 
              stroke-linecap="round" 
              stroke-linejoin="round"
              class="transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>

          <!-- Copy Button -->
          <button 
            id="copy-email-btn"
            type="button"
            data-email={contact.email}
            class="inline-flex items-center justify-center px-4 py-2 rounded-full border border-[#111111]/20 font-body text-xs tracking-wider uppercase text-[#111111] hover:bg-[#111111] hover:text-[#f2f2f2] transition-all duration-200 cursor-pointer self-start sm:self-auto"
            aria-label="Copy email address to clipboard"
          >
            <span id="copy-email-text">COPY EMAIL</span>
          </button>
        </div>
      </div>

      <!-- Quick Agency Details & Links (5 Cols) -->
      <div class="md:col-span-5 grid grid-cols-2 gap-6 sm:gap-8">
        <div>
          <span class="font-body text-xs tracking-[0.2em] uppercase text-[#838282] block mb-2">
            INSTAGRAM
          </span>
          <a 
            href={contact.instagramUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="font-body text-base font-semibold text-[#111111] hover:underline underline-offset-4 flex items-center gap-1.5"
          >
            <span>{contact.instagramHandle}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>

        <div>
          <span class="font-body text-xs tracking-[0.2em] uppercase text-[#838282] block mb-2">
            LOCATION
          </span>
          <p class="font-body text-base font-medium text-[#111111]">
            {contact.location}
          </p>
          <span class="text-xs text-[#838282] tracking-wider uppercase">GLOBAL COMMISSION</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupCopyButton() {
    const btn = document.getElementById('copy-email-btn');
    const label = document.getElementById('copy-email-text');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      try {
        await navigator.clipboard.writeText(email);
        const originalText = label.textContent;
        label.textContent = 'COPIED TO CLIPBOARD ✓';
        btn.classList.add('bg-[#111111]', 'text-[#f2f2f2]');
        setTimeout(() => {
          label.textContent = originalText;
          btn.classList.remove('bg-[#111111]', 'text-[#f2f2f2]');
        }, 2200);
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyButton);
  } else {
    setupCopyButton();
  }
  document.addEventListener('astro:page-load', setupCopyButton);
</script>
